# Palace auth gateway configuration. Installed as auth/config.env (chmod 600).
# Precedence: built-in defaults < this file < process environment.

PALACE_AUTH_HOST=127.0.0.1
PALACE_AUTH_PORT=3090
PALACE_PUBLIC_ORIGIN=https://bot.pu-ji.top
PALACE_RP_ID=bot.pu-ji.top
PALACE_RP_NAME=Palace
PALACE_ALLOWED_HOSTS=bot.pu-ji.top
PALACE_UPSTREAM=http://127.0.0.1:3080
PALACE_DSH_CREDENTIALS=/home/ubuntu/palace/state/.credentials.yaml
PALACE_STATE_DIR=/home/ubuntu/palace/auth/var
PALACE_COOKIE_SECURE=1
PALACE_COOKIE_PREFIX=1
